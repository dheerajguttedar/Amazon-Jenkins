
pipeline {
    agent any

    environment {
        GIT_BRANCH = 'main'
        REPOSITORY_URL = 'https://github.com/dheerajguttedar/Amazon-Jenkins.git'
    }

    stages {

        stage('Pull SCM Git') {
            steps {
                git branch: "${GIT_BRANCH}",
                    url: "${REPOSITORY_URL}"
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn compile'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean install'
            }
        }
    }

    post {
        success {
            echo 'Build success'
        }

        failure {
            echo 'Failure in the build'
        }
    }
}

